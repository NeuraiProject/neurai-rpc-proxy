# Single source of truth for values shared by the neuraid and rpc-proxy
# services. Edit here ONCE and run `docker compose up -d`; both pick it up.
# Testnet values only — safe to keep in git.

# ── Node RPC ──────────────────────────────────────────────────────────────
# Used by neuraid (rpcport/rpcuser/rpcpassword) AND by the proxy's upstream
# connection (NEURAI_NODE_URL is built from NODE_RPC_PORT), so the two can
# never drift apart: change NODE_RPC_PORT here and the proxy follows.
NODE_RPC_USER=neurai
NODE_RPC_PASSWORD=neuraipassword12
NODE_RPC_PORT=19101

# ── RPC Proxy HTTP server ─────────────────────────────────────────────────────
# One value drives: the port the proxy listens on inside the container, the
# port published on the host, and the healthcheck.
PROXY_PORT=19222

# Host interface the proxy is published on:
#   127.0.0.1 -> loopback only. Secure. Your nginx MUST proxy_pass to
#                http://127.0.0.1:PROXY_PORT (NOT %ip%). Recommended.
#   0.0.0.0   -> all interfaces; reachable via the public IP directly, so a
#                HestiaCP template using http://%ip%:PROXY_PORT works — but the
#                port is then exposed to the internet without TLS. Use a firewall.
PROXY_BIND=127.0.0.1
