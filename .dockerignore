# Keep the build context small and never bake host-only files into the image.
node_modules
npm-debug.log*
yarn-error.log*

.git
.gitignore

# Local runtime config is generated by docker-entrypoint.sh from env vars.
# Excluding it prevents a developer's local config.json from leaking in.
config.json

# Other services' compose/build folders aren't part of the proxy image. Only
# docker/proxy-rpc/docker-entrypoint.sh is needed at build time; its Dockerfile
# is read directly by the builder and does not need to enter the image.
docker/mainnet
docker/testnet
docker/node
docker/proxy-rpc/Dockerfile

*.md

# Tests and coverage are not run inside the container.
*.test.js
coverage
.nyc_output

.dockerignore
